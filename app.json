{
  "expo": {
    "name": "Senior Insight Health Monitor",
    "slug": "senior-insight-health-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "seniorapp",
    "plugins": [
      "expo-sqlite",
      "expo-web-browser"
    ],
    "extra": {
      "apiBaseUrl": "https://seniorinsight-backend-br-73d00847a82b.herokuapp.com",
      "postgres": {
        "host": "localhost",
        "port": 5432,
        "database": "senior_insight_health"
      }
    }
  }
}
