{
  "expo": {
    "name": "Senior Insight Health Monitor",
    "slug": "senior-insight-health-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.seniorinsight.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O SeniorInsight utiliza sua localização em tempo real para monitorar o perímetro seguro e enviar socorro imediato em caso de SOS."
      }
    },
    "android": {
      "package": "br.com.seniorinsight.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_OXYGEN_SATURATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "seniorinsight",
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#253B80"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O SeniorInsight utiliza sua localização em tempo real para monitorar o perímetro seguro e enviar socorro imediato em caso de SOS."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O SeniorInsight usa a câmera só para ler o QR Code que seu familiar mostra. Nenhuma foto é guardada.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "open-wearables",
        {
          "healthShareUsage": "O Senior Insight lê os dados de saúde que você autorizou para acompanhar seu bem-estar.",
          "healthUpdateUsage": "O Senior Insight não grava dados de saúde no seu relógio."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/withMavenLocal"
    ]
  }
}
