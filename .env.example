# Host do si-api-gateway, SEM /api no final (os services já montam /api/v1/...).
# Issuer do realm no Keycloak: precisa ser igual ao issuer que o gateway valida.

# --- Docker Compose local (si-infra) ---
# O Keycloak local emite tokens com issuer http://localhost:8180/realms/seniorinsight,
# então o app também usa localhost. No emulador Android ou celular por USB rode
#   adb reverse tcp:8080 tcp:8080 && adb reverse tcp:8180 tcp:8180
# (o simulador iOS e o Expo web já enxergam o localhost do computador). Ver README.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8180/realms/seniorinsight

# --- VM da Azure (o Keycloak roda sob /auth) ---
# EXPO_PUBLIC_API_BASE_URL=https://<host-da-vm>
# EXPO_PUBLIC_KEYCLOAK_ISSUER=https://<host-da-vm>/auth/realms/seniorinsight
