# Host do si-api-gateway, SEM /api no final (os services já montam /api/v1/...).
# Issuer do realm no Keycloak (o Keycloak roda com KC_HTTP_RELATIVE_PATH=/auth).

# --- Docker Compose local ---
# Use o IP da sua máquina na rede (ex.: ipconfig / ip addr), não localhost:
# o celular/emulador não enxerga o localhost do computador.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://192.168.0.10:8080/auth/realms/seniorinsight

# --- VM da Azure ---
# EXPO_PUBLIC_API_BASE_URL=https://<host-da-vm>
# EXPO_PUBLIC_KEYCLOAK_ISSUER=https://<host-da-vm>/auth/realms/seniorinsight
